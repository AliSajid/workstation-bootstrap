# Local-only migration inventory from the previous workstation.
# Keep it available to local tools (including OpenCode), but never commit it.
/migration_data/

# macOS filesystem noise
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.DocumentRevisions-V100/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Editor and IDE state
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.nvchad/
# Keep intentional Neovim configuration; ignore only generated local state.
.nvimlog
.nvimlog.*
.session
.sessions/

# Shell history, local environment, and machine-specific overrides
.zsh_history
.zsh_sessions/
.bash_history
.python_history
.lesshst
.env
.env.*
!.env.example
!.env.sample
!.env.template
.direnv/
mise.local.toml
.mise.local.toml
*.local

# Credentials, private keys, tokens, and local authentication state
# Do not store credentials in this repository, even if they are encrypted locally.
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/*credential*
**/*credentials*
**/*secret*
**/*secrets*
**/*token*
**/*tokens*
**/*private_key*
**/*service-account*.json
**/application_default_credentials.json
**/.netrc
**/.authinfo
**/known_hosts
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.mobileprovision
**/*.provisionprofile
**/gh/hosts.yml
**/gcloud/application_default_credentials.json
**/containers/auth.json
**/.config/gcloud/
**/.config/gh/hosts.yml
**/.ssh/

